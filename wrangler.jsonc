{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appaaaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c740b213-05f6-4f49-80ec-8980f79d383c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d9d89ccdc5c14b75a9acbccaddcde6f9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
